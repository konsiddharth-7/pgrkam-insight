generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "analytics"]
}

// =====================================================
// OPERATIONAL TABLES (public schema)
// =====================================================

model users {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  password_hash String
  role          String   @default("candidate")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  applications       applications[]
  candidate_profiles candidate_profiles?
  candidate_skills   candidate_skills[]
  jobs               jobs[]
  recommendations    recommendations[]
  saved_jobs         saved_jobs[]
  user_events        user_events[]

  @@schema("public")
}

model candidate_profiles {
  id                 Int       @id @default(autoincrement())
  user_id            Int       @unique
  education          String?
  experience_years   Decimal?  @default(0) @db.Decimal(4, 1)
  location           String?
  preferred_location String?
  preferred_category String?
  bio                String?
  gender             String?
  date_of_birth      DateTime? @db.Date
  district           String?
  profile_completed  Boolean   @default(false)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model skills {
  id         Int     @id @default(autoincrement())
  skill_name String  @unique
  category   String?

  candidate_skills candidate_skills[]
  job_skills       job_skills[]

  @@schema("public")
}

model candidate_skills {
  id          Int @id @default(autoincrement())
  user_id     Int
  skill_id    Int
  proficiency Int @default(3)

  skills skills @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users  users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, skill_id])
  @@schema("public")
}

model jobs {
  id                  Int      @id @default(autoincrement())
  employer_id         Int?
  title               String
  company             String
  description         String?
  location            String?
  salary_min          Int?
  salary_max          Int?
  experience_required Decimal? @default(0) @db.Decimal(4, 1)
  category            String?
  status              String   @default("open")
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  users           users?            @relation(fields: [employer_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  applications    applications[]
  job_skills      job_skills[]
  recommendations recommendations[]
  saved_jobs      saved_jobs[]

  @@schema("public")
}

model job_skills {
  id         Int @id @default(autoincrement())
  job_id     Int
  skill_id   Int
  importance Int @default(3)

  jobs   jobs   @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skills skills @relation(fields: [skill_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([job_id, skill_id])
  @@schema("public")
}

model saved_jobs {
  id       Int      @id @default(autoincrement())
  user_id  Int
  job_id   Int
  saved_at DateTime @default(now()) @db.Timestamptz(6)

  jobs  jobs  @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, job_id])
  @@schema("public")
}

model recommendations {
  id                Int      @id @default(autoincrement())
  user_id           Int
  job_id            Int
  match_score       Decimal  @db.Decimal(5, 2)
  matched_skills    Json     @default("[]")
  missing_skills    Json     @default("[]")
  algorithm_version String   @default("v1-weighted")
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  jobs                  jobs                    @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                 users                   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  applications          applications[]
  recommendation_events recommendation_events[]

  @@schema("public")
}

model applications {
  id                Int      @id @default(autoincrement())
  user_id           Int
  job_id            Int
  recommendation_id Int?
  status            String   @default("Applied")
  applied_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  jobs            jobs             @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recommendations recommendations? @relation(fields: [recommendation_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users           users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, job_id])
  @@schema("public")
}

// =====================================================
// ANALYTICS TABLES (analytics schema)
// =====================================================

model user_events {
  id           BigInt   @id @default(autoincrement())
  event_id     String   @unique @db.Uuid
  user_id      Int?
  anonymous_id String?
  event_name   String
  source       String?
  campaign     String?
  device       String?
  session_id   String
  event_time   DateTime @db.Timestamptz(6)
  ingested_at  DateTime @default(now()) @db.Timestamptz(6)
  properties   Json     @default("{}")

  users users? @relation(fields: [user_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([event_name, event_time], map: "idx_events_name_time")
  @@index([event_time], map: "idx_events_time")
  @@index([user_id], map: "idx_events_user")
  @@schema("analytics")
}

model acquisition_sources {
  id          Int    @id @default(autoincrement())
  source_name String
  campaign    String @default("")

  @@unique([source_name, campaign])
  @@schema("analytics")
}

model recommendation_events {
  id                BigInt   @id @default(autoincrement())
  recommendation_id Int
  event_type        String
  event_time        DateTime @default(now()) @db.Timestamptz(6)

  recommendations recommendations @relation(fields: [recommendation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([recommendation_id], map: "idx_recev_rec")
  @@schema("analytics")
}

model daily_metrics {
  id            BigInt   @id @default(autoincrement())
  metric_date   DateTime @db.Date
  metric_name   String
  metric_value  Decimal  @db.Decimal
  dimensions    Json     @default("{}")
  calculated_at DateTime @default(now()) @db.Timestamptz(6)

  // The unique index uq_daily_metrics exists in the database but Prisma cannot
  // express a unique key that includes a Json column, so it is omitted here.
  @@schema("analytics")
}

model rejected_events {
  id          BigInt   @id @default(autoincrement())
  payload     Json
  reason      String
  rejected_at DateTime @default(now()) @db.Timestamptz(6)

  @@schema("analytics")
}

model etl_runs {
  id             Int       @id @default(autoincrement())
  started_at     DateTime  @default(now()) @db.Timestamptz(6)
  finished_at    DateTime? @db.Timestamptz(6)
  status         String    @default("running")
  rows_processed Int?      @default(0)
  last_event_id  BigInt?   @default(0)
  error          String?

  @@schema("analytics")
}